{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}\\vendor",
                "-I${workspaceFolder}\\vendor\\imgui",
                "-I${workspaceFolder}\\include",
                "-I", "C:\\mingw64\\include",
                "-I", "C:\\mingw64\\include\\SDL2",
                "${fileDirname}\\*.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui_draw.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui_tables.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui_widgets.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui_impl_sdl2.cpp",
                "${workspaceFolder}\\vendor\\imgui\\imgui_impl_opengl3.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-L", "C:\\mingw64\\x86_64-w64-mingw32\\lib",
                "-Wl,-Bstatic",
                "-lSDL2",
                "-lSDL2main",
                "-Wl,-Bdynamic",
                "-lmingw32",
                "-lopengl32",
                "-limm32",
                "-lversion",
                "-lole32",
                "-loleaut32",
                "-lwinmm",
                "-lgdi32",
                "-lsetupapi",
                "-static-libgcc",
                "-static-libstdc++"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}